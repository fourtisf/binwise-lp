# Database / cache
DATABASE_URL=postgresql://binwise:binwise@localhost:5432/binwise
REDIS_URL=redis://localhost:6379

# Solana
RPC_URL=                # Helius/Triton mainnet
RPC_WS_URL=
DEVNET_RPC_URL=
JUPITER_API_URL=
JITO_BLOCK_ENGINE_URL=

# Agent custody (libsodium sealed box key). Never commit a real value.
AGENT_KEY_ENCRYPTION_SECRET=

# Safety: live trading stays off unless this is "true" AND the vault opts in.
LIVE_TRADING_ENABLED=false

# Alerts
TELEGRAM_BOT_TOKEN=

# API server
API_PORT=4000
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# Web. Leave both empty to run the website on its built-in mock data (no API needed).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
