# ---------- Database / cache ----------
DATABASE_URL=postgresql://kovra:kovra@localhost:5432/kovra
REDIS_URL=redis://localhost:6379

# ---------- Solana ----------
RPC_URL=                     # Helius/Triton mainnet, e.g. https://mainnet.helius-rpc.com/?api-key=KEY
RPC_WS_URL=
DEVNET_RPC_URL=
# Meteora DLMM Data API (public, no key)
METEORA_API_URL=https://dlmm.datapi.meteora.ag
# Jupiter (price + swaps). Key optional; keyless is rate-limited.
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=
# Set to send live transactions through Jito bundles
JITO_BLOCK_ENGINE_URL=
JITO_TIP_LAMPORTS=10000

# ---------- Safety ----------
# Live trading stays off unless this is "true" AND the vault owner switches to live.
LIVE_TRADING_ENABLED=false
# Only these wallets (comma-separated) may switch a vault to live. Empty = nobody.
LIVE_WALLETS=
# Telegram ids (comma-separated) that may create a live wallet in the bot. LIVE_WALLETS=* allows everyone.
LIVE_TELEGRAM_IDS=
# Hard limits per live vault: max USD in positions, max number of positions (0 = no limit)
LIVE_MAX_USD=200
LIVE_MAX_POSITIONS=1
# Max USD in positions across ALL live vaults together
LIVE_MAX_TOTAL_USD=2000
# Smallest position the agent opens, in USD (default 50, never below 1)
MIN_POSITION_USD=50
# "live": new wallets start on mainnet (needs LIVE_TRADING_ENABLED, RPC_URL and the wallet allowed; LIVE_WALLETS=* = everyone)
DEFAULT_VAULT_MODE=paper
# 32 random bytes, base64 (openssl rand -base64 32). Seals agent keypairs. Never commit it.
AGENT_KEY_ENCRYPTION_SECRET=
# Kill switch over HTTP: POST /admin/kill with header x-admin-token
ADMIN_TOKEN=

# ---------- API ----------
API_PORT=4000
API_HOST=127.0.0.1
# At least 32 random characters (openssl rand -hex 32). Signs login sessions.
SESSION_SECRET=
# Shown in the wallet sign-in message
PUBLIC_DOMAIN=kovra.live
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# "mock" serves the simulator instead of the database
API_MODE=

# ---------- Agent ----------
AGENT_CONCURRENCY=4

# ---------- Alerts ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---------- Web (build time) ----------
# Leave the API URLs empty to run the website on its built-in simulation (no backend needed).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# RPC the browser uses for live deposits (a public endpoint is fine)
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Same as DEFAULT_VAULT_MODE, for the website copy ("live" = no promises of a simulation)
NEXT_PUBLIC_DEFAULT_VAULT_MODE=paper
# Public address of the site, for link previews on X, Telegram, ... (defaults to the origin of NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_SITE_URL=
# The Telegram bot's username (no @) for links on the website. Empty: the website links to no bot.
NEXT_PUBLIC_TELEGRAM_BOT=
# The token's contract address, shown on the landing page with a copy button. Empty: "CA: Coming soon".
NEXT_PUBLIC_TOKEN_CA=
