{
  "name": "@kovra/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "collector": "node --env-file-if-exists=../../.env --import tsx src/collector-main.ts",
    "agent": "node --env-file-if-exists=../../.env --import tsx src/agent-main.ts",
    "backtest": "node --env-file-if-exists=../../.env --import tsx src/backtest-main.ts",
    "optimize": "node --env-file-if-exists=../../.env --import tsx src/optimize-main.ts",
    "kill": "node --env-file-if-exists=../../.env --import tsx src/kill-main.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed-main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@kovra/chain": "workspace:*",
    "@kovra/core": "workspace:*",
    "@kovra/db": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "ioredis": "5.11.1",
    "tsx": "4.23.15"
  }
}
